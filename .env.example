# Docker Compose binds services to loopback. These are local demo credentials.
APP_PORT=8080
APP2_PORT=8081
MYSQL_PORT=33060
REDIS_PORT=63790
KAFKA_PORT=19092
# For host-native Go execution (defaults shown):
MYSQL_DSN=syncframe:syncframe@tcp(127.0.0.1:33060)/syncframe?parseTime=true&timeout=3s&readTimeout=5s&writeTimeout=5s
REDIS_ADDR=127.0.0.1:63790
KAFKA_BROKER=127.0.0.1:19092
ADDR=:8080
WEB_DIR=web/dist
# Optional exact allowed browser origin; leave unset for same-host checking.
# APP_ORIGIN=http://localhost:8080
